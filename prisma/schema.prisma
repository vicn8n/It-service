// IT Service Desk — Enterprise ITSM schema (PostgreSQL)
// ระบบแจ้งซ่อม IT + ทะเบียนทรัพย์สิน + Knowledge Base + Asset Lifecycle + Approval/Workflow

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════ ผู้ใช้ / องค์กร ═══════════════

enum Role {
  ADMIN // ผู้ดูแลระบบ
  MANAGER // หัวหน้า/ผู้อนุมัติ
  AGENT // เจ้าหน้าที่ IT
  USER // ผู้ใช้ทั่วไป
}

enum AuthProvider {
  LOCAL // รหัสผ่านในระบบ
  LDAP // Active Directory / LDAP
}

model Location {
  id        Int      @id @default(autoincrement())
  name      String // เช่น สำนักงานกรุงเทพ, โรงงานสมุทรปราการ
  code      String?  @unique
  address   String?
  parentId  Int?     @map("parent_id")
  createdAt DateTime @default(now())

  parent   Location?  @relation("LocationTree", fields: [parentId], references: [id])
  children Location[] @relation("LocationTree")
  users    User[]
  assets   Asset[]

  @@map("locations")
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  parentId  Int?     @map("parent_id")
  managerId Int?     @map("manager_id")
  createdAt DateTime @default(now())

  parent   Department?  @relation("DeptTree", fields: [parentId], references: [id])
  children Department[] @relation("DeptTree")
  users    User[]
  assets   Asset[]

  @@map("departments")
}

model User {
  id           Int          @id @default(autoincrement())
  email        String       @unique
  username     String?      @unique
  passwordHash String?      @map("password_hash") // null เมื่อ login ผ่าน LDAP
  authProvider AuthProvider @default(LOCAL) @map("auth_provider")
  fullName     String       @map("full_name")
  phone        String?
  jobTitle     String?      @map("job_title")
  role         Role         @default(USER)
  isActive     Boolean      @default(true) @map("is_active")
  departmentId Int?         @map("department_id")
  locationId   Int?         @map("location_id")
  managerId    Int?         @map("manager_id") // ผู้บังคับบัญชา (ใช้ routing approval)

  // ความปลอดภัย: ล็อกบัญชี + 2FA
  failedLogins Int       @default(0) @map("failed_logins")
  lockedUntil  DateTime? @map("locked_until")
  sessionVersion Int    @default(0) @map("session_version")
  totpSecret   String?   @map("totp_secret")
  totpEnabled  Boolean   @default(false) @map("totp_enabled")

  // แจ้งเตือนผ่าน Telegram
  telegramChatId String? @map("telegram_chat_id")

  // แจ้งเตือนผ่าน Email
  emailNotify Boolean @default(false) @map("email_notify")

  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  department       Department?         @relation(fields: [departmentId], references: [id])
  location         Location?           @relation(fields: [locationId], references: [id])
  manager          User?               @relation("UserManager", fields: [managerId], references: [id])
  reports          User[]              @relation("UserManager")
  reportedTickets  Ticket[]            @relation("Requester")
  assignedTickets  Ticket[]            @relation("Assignee")
  comments         TicketComment[]
  ownedAssets      Asset[]             @relation("AssetOwner")
  assetAssignments AssetAssignment[]
  auditLogs        AuditLog[]
  kbArticles       KbArticle[]
  approvals        Approval[]          @relation("Approver")
  notifications    UserNotification[]
  licenseSeats     LicenseAssignment[]
  teamMemberships  TeamMember[]
  ownedProblems    Problem[]           @relation("ProblemOwner")
  requestedChanges Change[]            @relation("ChangeRequester")

  @@index([role])
  @@index([departmentId])
  @@index([managerId])
  @@map("users")
}

// ═══════════════ Ticket / Service Request ═══════════════

enum TicketType {
  INCIDENT // เหตุขัดข้อง/แจ้งซ่อม
  SERVICE_REQUEST // คำขอรับบริการ (ขอสิทธิ์/ติดตั้ง/ขออุปกรณ์)
}

enum TicketStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  PENDING
  AWAITING_APPROVAL // รออนุมัติ
  RESOLVED
  CLOSED
  CANCELLED
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  icon      String?
  teamId    Int?     @map("team_id") // ทีมที่รับผิดชอบหมวดนี้ (auto-assign)
  createdAt DateTime @default(now())

  tickets   Ticket[]
  slaPolicies SlaPolicy[]
  team      Team?      @relation(fields: [teamId], references: [id])

  @@map("categories")
}

model SlaPolicy {
  id              Int      @id @default(autoincrement())
  // null = ค่าเริ่มต้นของระดับความสำคัญนั้น, มีค่า = กำหนดเฉพาะหมวดหมู่ (1 หมวดมีได้ครบ 4 ระดับ)
  categoryId      Int?     @map("category_id")
  priority        Priority
  responseMinutes Int      @map("response_minutes")
  resolveMinutes  Int      @map("resolve_minutes")
  createdAt       DateTime @default(now())

  category Category? @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, priority])
  @@map("sla_policies")
}

// Service Catalog — รายการบริการที่ผู้ใช้ขอได้
model ServiceCatalogItem {
  id               Int      @id @default(autoincrement())
  name             String
  description      String?
  icon             String?
  categoryId       Int?     @map("category_id")
  requiresApproval Boolean  @default(false) @map("requires_approval")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now())

  tickets Ticket[]

  @@map("service_catalog_items")
}

model Ticket {
  id          Int          @id @default(autoincrement())
  ticketNo    String       @unique @map("ticket_no")
  type        TicketType   @default(INCIDENT)
  subject     String
  description String
  status      TicketStatus @default(NEW)
  priority    Priority     @default(MEDIUM)
  categoryId  Int?         @map("category_id")
  catalogId   Int?         @map("catalog_id")
  location    String?
  deskPhone   String?      @map("desk_phone")
  mobilePhone String?      @map("mobile_phone")
  requesterId Int          @map("requester_id")
  assigneeId  Int?         @map("assignee_id")
  teamId      Int?         @map("team_id")
  assetId     Int?         @map("asset_id")
  problemId   Int?         @map("problem_id")

  responseDueAt DateTime? @map("response_due_at")
  resolveDueAt  DateTime? @map("resolve_due_at")
  firstRespAt   DateTime? @map("first_response_at")
  resolvedAt    DateTime? @map("resolved_at")
  closedAt      DateTime? @map("closed_at")
  slaBreached   Boolean   @default(false) @map("sla_breached")
  // ตอบรับครั้งแรก (firstRespAt) ช้ากว่า responseDueAt
  responseBreached Boolean @default(false) @map("response_breached")

  satisfaction Int?    @map("satisfaction_rating")
  feedback     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category    Category?           @relation(fields: [categoryId], references: [id])
  catalogItem ServiceCatalogItem? @relation(fields: [catalogId], references: [id])
  requester   User                @relation("Requester", fields: [requesterId], references: [id])
  assignee    User?               @relation("Assignee", fields: [assigneeId], references: [id])
  team        Team?               @relation(fields: [teamId], references: [id])
  asset       Asset?              @relation(fields: [assetId], references: [id])
  problem     Problem?            @relation(fields: [problemId], references: [id])
  comments    TicketComment[]
  attachments TicketAttachment[]
  approvals   Approval[]

  @@index([status])
  @@index([type])
  @@index([priority])
  @@index([requesterId])
  @@index([assigneeId])
  @@index([teamId])
  @@index([assetId])
  @@index([createdAt])
  @@index([slaBreached])
  @@index([resolvedAt])
  @@index([closedAt])
  @@map("tickets")
}

model TicketComment {
  id         Int      @id @default(autoincrement())
  ticketId   Int      @map("ticket_id")
  authorId   Int      @map("author_id")
  body       String
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
  @@map("ticket_comments")
}

model TicketAttachment {
  id        Int      @id @default(autoincrement())
  ticketId  Int      @map("ticket_id")
  fileName  String   @map("file_name")
  filePath  String   @map("file_path")
  fileSize  Int      @map("file_size")
  mimeType  String   @map("mime_type")
  createdAt DateTime @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_attachments")
}

// ═══════════════ Approval / Workflow ═══════════════

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Approval {
  id         Int            @id @default(autoincrement())
  ticketId   Int            @map("ticket_id")
  approverId Int            @map("approver_id")
  status     ApprovalStatus @default(PENDING)
  comment    String?
  decidedAt  DateTime?      @map("decided_at")
  createdAt  DateTime       @default(now()) @map("created_at")

  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  approver User   @relation("Approver", fields: [approverId], references: [id])

  @@index([ticketId])
  @@index([approverId, status])
  @@map("approvals")
}

// ═══════════════ Knowledge Base ═══════════════

model KbCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  icon      String?
  createdAt DateTime @default(now())

  articles KbArticle[]

  @@map("kb_categories")
}

model KbArticle {
  id         Int      @id @default(autoincrement())
  title      String
  body       String // เนื้อหา (markdown/plain)
  summary    String?
  categoryId Int?     @map("category_id")
  tags       String? // คั่นด้วย comma
  published  Boolean  @default(false)
  views      Int      @default(0)
  authorId   Int      @map("author_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  category    KbCategory?    @relation(fields: [categoryId], references: [id])
  author      User           @relation(fields: [authorId], references: [id])
  attachments KbAttachment[]

  @@index([published])
  @@index([categoryId])
  @@map("kb_articles")
}

model KbAttachment {
  id        Int      @id @default(autoincrement())
  articleId Int      @map("article_id")
  fileName  String   @map("file_name")
  filePath  String   @map("file_path")
  fileSize  Int      @map("file_size")
  mimeType  String   @map("mime_type")
  createdAt DateTime @default(now()) @map("created_at")

  article KbArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@map("kb_attachments")
}

// ═══════════════ ทรัพย์สิน / Asset Lifecycle ═══════════════

enum AssetStatus {
  IN_USE
  IN_STOCK
  REPAIR
  LOANED
  RETIRED
  DISPOSED // จำหน่าย/ทิ้งแล้ว
}

model AssetType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  icon      String?
  createdAt DateTime @default(now())

  assets Asset[]

  @@map("asset_types")
}

model Vendor {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  contactName String?  @map("contact_name")
  phone       String?
  email       String?
  taxId       String?  @map("tax_id")
  address     String?
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  assets    Asset[]
  contracts Contract[]
  licenses  SoftwareLicense[]

  @@map("vendors")
}

enum ContractType {
  WARRANTY // ประกัน
  MAINTENANCE // สัญญาบำรุงรักษา (MA)
  SUBSCRIPTION // บอกรับสมาชิก
  LEASE // เช่า
  SUPPORT // สัญญาสนับสนุน
}

model Contract {
  id           Int          @id @default(autoincrement())
  contractNo   String       @unique @map("contract_no")
  name         String
  type         ContractType
  vendorId     Int?         @map("vendor_id")
  startDate    DateTime     @map("start_date")
  endDate      DateTime     @map("end_date")
  value        Decimal?     @db.Decimal(14, 2)
  autoRenew    Boolean      @default(false) @map("auto_renew")
  notes        String?
  createdAt    DateTime     @default(now()) @map("created_at")

  vendor Vendor? @relation(fields: [vendorId], references: [id])
  assets Asset[]

  @@index([endDate])
  @@map("contracts")
}

model Asset {
  id            Int         @id @default(autoincrement())
  assetTag      String      @unique @map("asset_tag")
  typeId        Int         @map("type_id")
  brand         String
  model         String
  serialNo      String?     @map("serial_no")
  hostname      String?
  ipAddress     String?     @map("ip_address")
  macAddress    String?     @map("mac_address")
  specification String?
  os            String?
  officeSuite   String?     @map("office_suite")
  accountingAssetCode String? @map("accounting_asset_code")
  status        AssetStatus @default(IN_STOCK)
  locationId    Int?        @map("location_id")
  locationText  String?     @map("location_text") // รายละเอียดที่ตั้งย่อย เช่น ห้อง/โต๊ะ

  ownerId      Int? @map("owner_id")
  departmentId Int? @map("department_id")
  vendorId     Int? @map("vendor_id")
  contractId   Int? @map("contract_id")

  purchaseDate     DateTime? @map("purchase_date")
  purchasePrice    Decimal?  @map("purchase_price") @db.Decimal(12, 2)
  poNumber         String?   @map("po_number")
  warrantyExpiry   DateTime? @map("warranty_expiry")
  usefulLifeMonths Int?      @map("useful_life_months") // อายุใช้งานสำหรับคิดค่าเสื่อม
  salvageValue     Decimal?  @map("salvage_value") @db.Decimal(12, 2)

  lastSeenAt DateTime? @map("last_seen_at") // ตรวจนับครั้งล่าสุด (stock-take)

  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  type          AssetType         @relation(fields: [typeId], references: [id])
  owner         User?             @relation("AssetOwner", fields: [ownerId], references: [id])
  department    Department?       @relation(fields: [departmentId], references: [id])
  location      Location?         @relation(fields: [locationId], references: [id])
  vendor        Vendor?           @relation(fields: [vendorId], references: [id])
  contract      Contract?         @relation(fields: [contractId], references: [id])
  tickets       Ticket[]
  assignments   AssetAssignment[]
  attachments   AssetAttachment[]
  relationsFrom AssetRelation[]   @relation("RelSource")
  relationsTo   AssetRelation[]   @relation("RelTarget")
  softwareAssignments AssetSoftwareAssignment[]

  @@index([status])
  @@index([typeId])
  @@index([ownerId])
  @@index([warrantyExpiry])
  @@map("assets")
}

model AssetAssignment {
  id         Int       @id @default(autoincrement())
  assetId    Int       @map("asset_id")
  userId     Int       @map("user_id")
  assignedAt DateTime  @default(now()) @map("assigned_at")
  returnedAt DateTime? @map("returned_at")
  note       String?

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([assetId])
  @@map("asset_assignments")
}

model AssetAttachment {
  id        Int      @id @default(autoincrement())
  assetId   Int      @map("asset_id")
  fileName  String   @map("file_name")
  filePath  String   @map("file_path")
  fileSize  Int      @map("file_size")
  mimeType  String   @map("mime_type")
  createdAt DateTime @default(now()) @map("created_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("asset_attachments")
}

// ═══════════════ Software License ═══════════════

model SoftwareLicense {
  id         Int       @id @default(autoincrement())
  name       String // เช่น Microsoft 365 Business
  publisher  String? // ผู้ผลิตซอฟต์แวร์
  licenseKey String?   @map("license_key")
  vendorId   Int?      @map("vendor_id")
  totalSeats Int       @default(1) @map("total_seats")
  expiry     DateTime?
  cost       Decimal?  @db.Decimal(12, 2)
  notes      String?
  createdAt  DateTime  @default(now()) @map("created_at")

  // รอบชำระเงิน (subscription) — ใช้แจ้งเตือนก่อนถึงวันจ่าย
  billingCycle           String    @default("NONE") @map("billing_cycle") // NONE | MONTHLY | YEARLY
  nextBillingDate        DateTime? @map("next_billing_date") @db.Date
  billingDay             Int?      @map("billing_day") // วันที่ของเดือนที่ต้องจ่าย (กันวันเลื่อนหลังเดือนสั้น)
  billingAmount          Decimal?  @map("billing_amount") @db.Decimal(12, 2)
  remindDaysBefore       Int       @default(3) @map("remind_days_before")
  lastBillingRemindedFor DateTime? @map("last_billing_reminded_for") @db.Date

  vendor      Vendor?             @relation(fields: [vendorId], references: [id])
  assignments LicenseAssignment[]
  assetAssignments AssetSoftwareAssignment[]

  @@index([expiry])
  @@index([nextBillingDate])
  @@map("software_licenses")
}

model LicenseAssignment {
  id         Int      @id @default(autoincrement())
  licenseId  Int      @map("license_id")
  userId     Int      @map("user_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  license SoftwareLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id])

  @@unique([licenseId, userId])
  @@index([licenseId])
  @@map("license_assignments")
}

model AssetSoftwareAssignment {
  id         Int      @id @default(autoincrement())
  assetId    Int      @map("asset_id")
  licenseId  Int      @map("license_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  note       String?

  asset   Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  license SoftwareLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([assetId, licenseId])
  @@index([assetId])
  @@index([licenseId])
  @@map("asset_software_assignments")
}

// ═══════════════ Admin / ระบบ ═══════════════

// เวลาทำการ (ใช้คำนวณ SLA แบบ business hours ในอนาคต)
model BusinessHours {
  id        Int     @id @default(autoincrement())
  dayOfWeek Int     @map("day_of_week") // 0=อาทิตย์ ... 6=เสาร์
  startTime String  @map("start_time") // "08:30"
  endTime   String  @map("end_time") // "17:30"
  isWorking Boolean @default(true) @map("is_working")

  @@unique([dayOfWeek])
  @@map("business_hours")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   Int?     @map("entity_id")
  detail     String?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// อีเมลที่ส่งออก (สำหรับ audit/retry)
model Notification {
  id        Int       @id @default(autoincrement())
  toEmail   String    @map("to_email")
  subject   String
  body      String
  sent      Boolean   @default(false)
  sentAt    DateTime? @map("sent_at")
  error     String?
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([sent])
  @@map("notifications")
}

// การแจ้งเตือนภายในแอป (in-app notification)
model UserNotification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String
  body      String?
  link      String? // route ในแอป เช่น ticket-detail:24
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("user_notifications")
}

// สิทธิ์การเข้าถึงเมนู/ฟีเจอร์ต่อ role (จัดการผ่านหน้า "ตั้งค่าระบบ" โดย ADMIN)
model RolePermission {
  id      Int     @id @default(autoincrement())
  role    Role
  menuKey String  @map("menu_key")
  allowed Boolean @default(true)

  @@unique([role, menuKey])
  @@map("role_permissions")
}

// ค่าตั้งค่าระบบที่แก้จากหน้าเว็บ (ค่าลับเก็บแบบเข้ารหัส เช่น Telegram bot token)
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model Counter {
  id    String @id
  value Int    @default(0)

  @@map("counters")
}

// ═══════════════ Teams / Queues ═══════════════

model Team {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  members    TeamMember[]
  categories Category[]
  tickets    Ticket[]

  @@map("teams")
}

model TeamMember {
  id        Int      @id @default(autoincrement())
  teamId    Int      @map("team_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

// ═══════════════ Problem Management (ITIL) ═══════════════

enum ProblemStatus {
  OPEN
  INVESTIGATING
  KNOWN_ERROR // ทราบสาเหตุแล้ว มี workaround
  RESOLVED
  CLOSED
}

model Problem {
  id          Int           @id @default(autoincrement())
  problemNo   String        @unique @map("problem_no")
  title       String
  description String
  status      ProblemStatus @default(OPEN)
  priority    Priority      @default(MEDIUM)
  rootCause   String?       @map("root_cause")
  workaround  String?
  ownerId     Int?          @map("owner_id")
  resolvedAt  DateTime?     @map("resolved_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  owner   User?    @relation("ProblemOwner", fields: [ownerId], references: [id])
  tickets Ticket[]
  changes Change[]

  @@index([status])
  @@map("problems")
}

// ═══════════════ Change Management (ITIL) ═══════════════

enum ChangeType {
  STANDARD // มาตรฐาน ความเสี่ยงต่ำ อนุมัติล่วงหน้า
  NORMAL // ปกติ ต้องอนุมัติ
  EMERGENCY // ฉุกเฉิน
}

enum ChangeStatus {
  DRAFT
  SUBMITTED
  APPROVED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

model Change {
  id                 Int          @id @default(autoincrement())
  changeNo           String       @unique @map("change_no")
  title              String
  description        String
  type               ChangeType   @default(NORMAL)
  status             ChangeStatus @default(DRAFT)
  risk               Priority     @default(MEDIUM) // ระดับความเสี่ยง
  requesterId        Int          @map("requester_id")
  problemId          Int?         @map("problem_id")
  plannedStart       DateTime?    @map("planned_start")
  plannedEnd         DateTime?    @map("planned_end")
  implementationPlan String?      @map("implementation_plan")
  rollbackPlan       String?      @map("rollback_plan")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  requester User     @relation("ChangeRequester", fields: [requesterId], references: [id])
  problem   Problem? @relation(fields: [problemId], references: [id])

  @@index([status])
  @@map("changes")
}

// ═══════════════ CMDB — ความสัมพันธ์ระหว่างทรัพย์สิน ═══════════════

enum RelationType {
  DEPENDS_ON // พึ่งพา
  CONNECTS_TO // เชื่อมต่อกับ
  PART_OF // เป็นส่วนหนึ่งของ
  INSTALLED_ON // ติดตั้งบน
  BACKUP_OF // สำรองของ
}

model AssetRelation {
  id        Int          @id @default(autoincrement())
  sourceId  Int          @map("source_id")
  targetId  Int          @map("target_id")
  type      RelationType @default(DEPENDS_ON)
  note      String?
  createdAt DateTime     @default(now()) @map("created_at")

  source Asset @relation("RelSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target Asset @relation("RelTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, type])
  @@index([sourceId])
  @@index([targetId])
  @@map("asset_relations")
}
