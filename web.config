<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS reverse proxy config สำหรับ IT Service Desk
  วางไฟล์นี้ที่ root ของ IIS site (เช่น C:\inetpub\itsd)
  ต้องติดตั้ง URL Rewrite + Application Request Routing (ARR) ก่อน
  และเปิด Proxy ใน ARR: IIS Manager > Server > Application Request Routing Cache > Server Proxy Settings > Enable proxy
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- บังคับ HTTPS -->
        <rule name="HTTP to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- ส่งทุก request ต่อไปยัง Node.js backend ที่ port 3200 -->
        <rule name="ReverseProxyToNode" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3200/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>

    <!-- ส่ง header ที่จำเป็น + ขนาด upload -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="12582912" /> <!-- 12MB request รองรับไฟล์แนบ 10MB -->
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    <!-- ปิด IIS static handler เพื่อให้ Node จัดการเอง -->
    <handlers>
      <clear />
      <add name="StaticFile" path="*" verb="*" type="" modules="StaticFileModule,DefaultDocumentModule,DirectoryListingModule" resourceType="Either" requireAccess="Read" />
    </handlers>
  </system.webServer>
</configuration>
