# ─────────── Database (PostgreSQL) ───────────
DATABASE_URL="postgresql://itsd_user:CHANGE_ME@localhost:5432/it_service_desk?schema=public"

# ─────────── Server ───────────
PORT=3200
NODE_ENV=production

# ─────────── Auth ───────────
# สร้างด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"
JWT_EXPIRES_IN="8h"

# ─────────── SMTP (Email notification) ───────────
SMTP_HOST="smtp.office365.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="itsupport@company.com"
SMTP_PASS="CHANGE_ME"
SMTP_FROM="IT Service Desk <itsupport@company.com>"
# ตั้งเป็น false เพื่อปิดการส่งอีเมลจริง (log ลง DB อย่างเดียว)
EMAIL_ENABLED=false

# ─────────── Uploads ───────────
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# ─────────── App ───────────
APP_URL="https://itsd.company.local"

# ─────────── นโยบายล็อกบัญชี ───────────
LOGIN_MAX_FAILED=5
LOGIN_LOCK_MINUTES=15

# ─────────── แจ้งเตือนผ่าน Telegram ───────────
# เปิด TELEGRAM_ENABLED=true + ใส่ token จาก @BotFather (ผู้ใช้ผูก chatId เองในหน้า account)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=

# ─────────── Email-to-Ticket (IMAP) ───────────
# เปิด IMAP_ENABLED=true แล้วตั้งค่าให้ครบ — เมลขาเข้าจะกลายเป็น ticket อัตโนมัติ
IMAP_ENABLED=false
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_TLS=true
IMAP_MAILBOX=INBOX
IMAP_POLL_SECONDS=60
# บังคับ: โดเมนผู้ส่งที่ยอมรับ คั่นด้วย comma (เช่น company.com,partner.com)
# ถ้าเว้นว่าง ระบบจะไม่เปิด email-to-ticket เพราะ From address ปลอมได้
IMAP_ALLOWED_DOMAINS=

# ─────────── LDAP/AD (ถ้าใช้ ต้อง npm i ldapjs) ───────────
LDAP_ENABLED=false

# ─── Backup นอกเครื่อง (ไม่บังคับ) ───
# deploy/backup.ps1 จะคัดลอก backup รายวัน/รายเดือนไปที่นี่ด้วย เช่น \nas01ackup\itsm
# account ที่รัน Scheduled Task "ITSM-Backup" ต้องเขียนที่ปลายทางได้
BACKUP_OFFSITE_DIR=
